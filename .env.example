NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca uses NEXT_PUBLIC_ con esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# Envío de correos (invitaciones, restablecimiento de contraseña y avisos de
# ticket informático) vía Resend. Sin estas dos variables, las invitaciones
# caen al email por defecto de Supabase, "olvidé mi contraseña" queda
# deshabilitado, y no se avisa por correo de tickets nuevos.
RESEND_API_KEY=
EMAIL_FROM="Intec Commercial Hub <no-reply@tudominio.com>"

# Ticket informático: a quién se avisa cuando llega una incidencia nueva.
ADMIN_EMAIL=

# URL pública de la app (p. ej. https://panel.suministrointec.com). Se usa en
# los enlaces de los correos (invitaciones, contraseñas, tickets, avisos). En
# producción no se confía en la cabecera Host de la petición: si falta, se usa el
# dominio de producción que da Vercel y, si tampoco existe, el envío falla.
NEXT_PUBLIC_APP_URL=

# Tareas programadas (vercel.json): Vercel las llama con este secreto. Sin él,
# los recordatorios de leads y el informe mensual no se ejecutan.
CRON_SECRET=

# Destinatarios del informe mensual automático (día 1 de cada mes), separados
# por comas. Si se deja vacío, se envía a ADMIN_EMAIL.
MONTHLY_REPORT_EMAILS=
