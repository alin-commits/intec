NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca uses NEXT_PUBLIC_ con esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# Envío de correos (invitaciones y restablecimiento de contraseña) vía Resend.
# Sin estas dos variables, las invitaciones caen al email por defecto de Supabase
# y "olvidé mi contraseña" queda deshabilitado.
RESEND_API_KEY=
EMAIL_FROM="Intec Commercial Hub <no-reply@tudominio.com>"
