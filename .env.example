NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca uses NEXT_PUBLIC_ con esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# Envío de correos (invitaciones, restablecimiento de contraseña y avisos de
# ticket informático) vía Resend. Sin estas dos variables, las invitaciones
# caen al email por defecto de Supabase, "olvidé mi contraseña" queda
# deshabilitado, y no se avisa por correo de tickets nuevos.
RESEND_API_KEY=
EMAIL_FROM="Intec Commercial Hub <no-reply@tudominio.com>"

# Ticket informático: a quién se avisa cuando llega una incidencia nueva.
ADMIN_EMAIL=

# URL pública de la app (p. ej. https://panel.suministrointec.com). Se usa en
# los enlaces de los correos (invitaciones, contraseñas, tickets, avisos). En
# producción no se confía en la cabecera Host de la petición: si falta, se usa el
# dominio de producción que da Vercel y, si tampoco existe, el envío falla.
NEXT_PUBLIC_APP_URL=

# Tareas programadas (vercel.json): Vercel las llama con este secreto. Sin él,
# los recordatorios de leads y el informe mensual no se ejecutan.
CRON_SECRET=

# Destinatarios del informe mensual automático (día 1 de cada mes), separados
# por comas. Si se deja vacío, se envía a ADMIN_EMAIL.
MONTHLY_REPORT_EMAILS=

# Lectura automática de facturas en Gastos → Facturas (Google Gemini, plan de
# pago: el gratuito no se permite para usuarios en la UE). Sin clave, las
# facturas se suben igual y los datos se rellenan a mano.
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-3.1-flash-lite; si está saturado prueba gemini-3.8-flash y gemini-3.5-flash).
GEMINI_MODEL=

# Gestor de contraseñas: clave maestra de cifrado (AES-256-GCM), 32 bytes en
# base64. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC. Si se pierde, las credenciales
# guardadas son irrecuperables: guarda una copia fuera de Vercel y de Supabase.
VAULT_ENCRYPTION_KEY=

# Envío de facturas a contabilidad (Gastos → Facturas). Opcionales: sin
# INVOICE_EMAIL_TO se envían al destinatario por defecto del código, y sin
# INVOICE_EMAIL_FROM salen desde EMAIL_FROM. El remitente debe ser del dominio
# verificado en Resend.
INVOICE_EMAIL_TO=
INVOICE_EMAIL_FROM=

# Agente de Sage (scripts/sage/agente-sage.ps1): clave compartida con la que el
# agente envía las ventas a /api/sage/ingest. Solo servidor. Sin ella, la ruta
# rechaza todos los envíos y el panel de Ventas deja de actualizarse.
SAGE_INGEST_TOKEN=

# ---------- Compras: reclamar la fecha desde el buzón ----------
# Registro de aplicación en Entra ID con permisos DE APLICACIÓN Mail.ReadWrite y
# Mail.Send, y limitado a ese buzón con una ApplicationAccessPolicy. Sin esto,
# las reclamaciones salen por Resend en nombre de compras@: llegan igual, pero
# no quedan en Enviados del buzón ni responden sobre el hilo del pedido.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_COMPRAS_MAILBOX=compras@tudominio.com
# El asunto con el que Sage manda el pedido, que es por donde se encuentra el
# hilo al que responder. Uno por código de sociedad; {numero} es el del pedido.
MS_COMPRAS_ASUNTOS={"1":"Pedidos de compra Empresa {numero}"}
# Para los primeros días: con esto puesto, TODAS las reclamaciones van a esta
# dirección en vez de al proveedor. Vaciarlo para enviar de verdad.
MS_COMPRAS_REDIRIGIR_A=

# Leer las respuestas de los proveedores (Compras → Contestados). Sin esto, la
# respuesta se detecta igual por el hilo del correo y el pedido se marca como
# contestado; lo que falta es el resumen de qué han dicho y la fecha propuesta.
ANTHROPIC_API_KEY=
